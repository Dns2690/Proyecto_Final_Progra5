# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Excepción: las librerías del proyecto sí se suben, para que compile
# en cualquier maquina sin tener que bajarlas a mano (MySQL Connector y JFreeChart)
!ProyectoFinal/lib/*.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ==========================================
# AGREGADOS PARA TU ENTORNO (MAC & NETBEANS)
# ==========================================

# Archivos temporales de Word (los crea al abrir un .docx)
~$*

# macOS (Para ignorar los archivos ocultos del sistema)
.DS_Store
.AppleDouble
.LSOverride
Icon

# NetBeans (Ajustado con ** para que cubra cualquier subcarpeta del proyecto)
**/nbproject/private/
**/build/
**/dist/
nbbuild/
nbdist/
.nb-gradle/

